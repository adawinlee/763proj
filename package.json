    "react-hot-loader": "^4.13.1",
    "webpack": "^5.102.1",
    "webpack-cli": "^4.2.0",
    "webpack-dev-middleware": "^7.4.5",
    "webpack-hot-middleware": "^2.26.1",
    "webpack-node-externals": "^2.5.2"
  },
  "dependencies": {
